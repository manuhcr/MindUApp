<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_vidro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/txtTipoProfissional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PSICÓLOGO"
            android:textColor="#75689A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <TextView
            android:id="@+id/txtNomeProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nome do profissional"
            android:textColor="#4B426D"
            android:textSize="17sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"/>

        <TextView
            android:id="@+id/txtTagsProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Ansiedade • Autocuidado"
            android:textColor="#777184"
            android:textSize="12sp"
            android:fontFamily="@font/plus_jakarta_sans"/>

        <TextView
            android:id="@+id/txtModalidadesProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Virtual • Presencial"
            android:textColor="#777184"
            android:textSize="12sp"
            android:fontFamily="@font/plus_jakarta_sans"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Ver perfil  ›"
            android:textColor="#75689A"
            android:textSize="12sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"/>

    </LinearLayout>

</eightbitlab.com.blurview.BlurView>