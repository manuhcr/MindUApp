<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_vidro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMPRESA"
            android:textColor="#75689A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/txtRazaoSocial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Razão Social da Empresa"
            android:textColor="#75689A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#5575689A" />

        <TextView
            android:id="@+id/txtIdEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID: 123"
            android:textColor="#777080"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtPlanoEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Plano: Premium"
            android:textColor="#514965"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnExcluirEmpresa"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:backgroundTint="#75689A"
            android:text="Excluir empresa"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</eightbitlab.com.blurview.BlurView>
