<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo utilizado pelo BlurView -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTargetDashboardEmpresa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/nova_cole__o_story_do_instagram_bege_marrom_5"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

    </eightbitlab.com.blurview.BlurTarget>

    <!-- Conteúdo dinâmico -->
    <FrameLayout
        android:id="@+id/containerEmpresa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navEmpresa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Navegação flutuante -->
    <LinearLayout
        android:id="@+id/navEmpresa"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_nav_admin"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/navInicioEmpresa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:scaleType="fitCenter"
            android:padding="18dp"
            android:contentDescription="Início"/>

        <ImageView
            android:id="@+id/navColaboradoresEmpresa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_users"
            android:scaleType="fitCenter"
            android:padding="18dp"
            android:contentDescription="Colaboradores"/>

        <ImageView
            android:id="@+id/navMatriculasEmpresa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_chart"
            android:scaleType="fitCenter"
            android:padding="18dp"
            android:contentDescription="Relatórios"/>

        <ImageView
            android:id="@+id/navPerfilEmpresa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_user"
            android:scaleType="fitCenter"
            android:padding="18dp"
            android:contentDescription="Perfil"/>

    </LinearLayout>


    <!-- Botão flutuante da Mila -->

    <FrameLayout
        android:id="@+id/fabMila"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_fab_mila"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        android:contentDescription="Abrir chat da Mila"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navEmpresa">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
