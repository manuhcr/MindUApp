<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F3F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MindU Corporate"
            android:textColor="#75689A"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtNomeEmpresa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Painel do Gestor"
            android:textColor="#777184"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <!-- Aviso LGPD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#E8E3F0"
            android:padding="14dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:tint="#75689A"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Dados 100% anônimos e protegidos por LGPD"
                android:textColor="#75689A"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Visão geral -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visão Geral do Mês"
            android:textColor="#292535"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="26dp"/>

        <TextView
            android:id="@+id/txtMesReferencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agosto 2026"
            android:textColor="#777184"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

        <!-- Indicadores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- Uso do benefício -->
            <LinearLayout
                android:id="@+id/cardUsoBeneficioEmpresa"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_vidro">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uso do Benefício"
                    android:textColor="#777184"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtUsoBeneficio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="78%"
                    android:textColor="#75689A"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/txtVariacaoUso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ +12% esse mês"
                    android:textColor="#43845B"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Sessões totais -->
            <LinearLayout
                android:id="@+id/cardSessoesEmpresa"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_vidro">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sessões Totais"
                    android:textColor="#777184"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtTotalSessoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="342"
                    android:textColor="#75689A"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="no benefício"
                    android:textColor="#777184"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Aderência -->
        <LinearLayout
            android:id="@+id/cardAderenciaEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_vidro">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aderência dos Colaboradores"
                android:textColor="#292535"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtAderenciaEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="140 / 180"
                android:textColor="#75689A"
                android:textSize="27sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <ProgressBar
                android:id="@+id/progressoAderenciaEmpresa"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:progress="78"
                android:max="100"
                android:progressTint="#75689A"
                android:progressBackgroundTint="#E2DDEC"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="77% dos colaboradores ativos realizaram ao menos 1 sessão."
                android:textColor="#777184"
                android:textSize="12sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
