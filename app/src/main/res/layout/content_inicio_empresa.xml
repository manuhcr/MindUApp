<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABEÇALHO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="MindU Corporate"
            android:textColor="#75689A"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtNomeEmpresa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Painel de gestão corporativa"
            android:textColor="#777184"
            android:textSize="14sp" />

        <!-- VISÃO GERAL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Visão Geral do Benefício"
            android:textColor="#292535"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMesReferencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Acompanhe a utilização do seu convênio."
            android:textColor="#777184"
            android:textSize="12sp" />

        <!-- INDICADORES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- TAXA DE UTILIZAÇÃO -->

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurUsoBeneficioEmpresa"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vidro"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/cardUsoBeneficioEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taxa de utilização"
                        android:textColor="#777184"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtUsoBeneficio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0%"
                        android:textColor="#75689A"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVariacaoUso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Do total de matrículas"
                        android:textColor="#777184"
                        android:textSize="11sp" />

                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

            <!-- MATRÍCULAS EM USO -->

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurSessoesEmpresa"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vidro"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/cardSessoesEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Matrículas em uso"
                        android:textColor="#777184"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtTotalSessoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0"
                        android:textColor="#75689A"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atualmente"
                        android:textColor="#777184"
                        android:textSize="11sp" />

                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

        </LinearLayout>

        <!-- MATRÍCULAS DISPONÍVEIS -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurAderenciaEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_vidro"
            android:clipToOutline="true">

            <LinearLayout
                android:id="@+id/cardAderenciaEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Matrículas disponíveis"
                    android:textColor="#292535"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAderenciaEmpresa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0"
                    android:textColor="#75689A"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressoAderenciaEmpresa"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#E2DDEC"
                    android:progressTint="#75689A" />

                <TextView
                    android:id="@+id/txtDescricaoMatriculas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Acompanhe a disponibilidade do seu convênio."
                    android:textColor="#777184"
                    android:textSize="12sp" />

            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <!-- COLABORADORES APROVADOS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atividades dos Colaboradores"
                android:textColor="#292535"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_vidro"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colaboradores aprovados"
                        android:textColor="#777184"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtClientesAprovados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="0"
                        android:textColor="#75689A"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RH"
                    android:textColor="#75689A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- GESTÃO DO CONVÊNIO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Gestão do Convênio"
            android:textColor="#292535"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- COLABORADORES -->

            <LinearLayout
                android:id="@+id/btnAtalhoColaboradores"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vidro"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Colaboradores"
                    android:src="@drawable/group" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Gestão de Colaboradores"
                    android:textColor="#292535"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- RELATÓRIOS -->

            <LinearLayout
                android:id="@+id/btnAtalhoRelatorios"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vidro"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Relatórios RH"
                    android:src="@drawable/group" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Relatórios RH"
                    android:textColor="#292535"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- SUPORTE -->

        <Button
            android:id="@+id/btnFalarConsultor"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#493D78"
            android:text="Falar com Consultor MindU"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
