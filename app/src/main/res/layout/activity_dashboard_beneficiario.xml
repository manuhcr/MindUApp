<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5FA">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTargetDashboardBeneficiario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Cabeçalho -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSaudacaoBeneficiario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Olá!"
                            android:textColor="#75689A"
                            android:textSize="21sp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sua jornada de cuidado mental começa aqui."
                            android:textColor="#777184"
                            android:textSize="11sp"/>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnNotificacoesBeneficiario"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:contentDescription="Notificações"
                        android:scaleType="centerInside" />

                </LinearLayout>

                <!-- Próxima sessão -->

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurProximaSessaoBeneficiario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_vidro"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Próxima sessão de terapia"
                            android:textColor="#4B426D"
                            android:textSize="14sp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"/>

                        <TextView
                            android:id="@+id/txtProximaSessaoBeneficiario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Nenhuma sessão agendada"
                            android:textColor="#777184"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </eightbitlab.com.blurview.BlurView>

                <!-- Acesso rápido -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Acesso rápido"
                    android:textColor="#75689A"
                    android:textSize="16sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <eightbitlab.com.blurview.BlurView
                        android:id="@+id/blurAgendamentoRapido"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_vidro"
                        android:clipToOutline="true"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/btnAgendamentoRapido"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Agendamento"
                                android:textColor="#4B426D"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </eightbitlab.com.blurview.BlurView>

                    <eightbitlab.com.blurview.BlurView
                        android:id="@+id/blurMilaRapido"
                        android:layout_width="0dp"
                        android:layout_height="105dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_vidro"
                        android:clipToOutline="true"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/btnFalarMila"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">



                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Falar com a MILA"
                                android:textColor="#4B426D"
                                android:textSize="12sp"/>

                        </LinearLayout>

                    </eightbitlab.com.blurview.BlurView>

                </LinearLayout>

                <!-- Bem-estar -->

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurBemEstarBeneficiario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_vidro"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SEU MOMENTO DE CUIDADO"
                            android:textColor="#75689A"
                            android:textSize="10sp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Cuide do seu bem-estar hoje"
                            android:textColor="#4B426D"
                            android:textSize="16sp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Reserve um momento para cuidar de você."
                            android:textColor="#777184"
                            android:textSize="12sp"/>

                        <Button
                            android:id="@+id/btnAgendarSessao"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#75689A"
                            android:text="Agendar sessão"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </eightbitlab.com.blurview.BlurView>

                <!-- Conteúdo de apoio -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Conteúdo de apoio"
                    android:textColor="#75689A"
                    android:textSize="16sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <eightbitlab.com.blurview.BlurView
                        android:id="@+id/blurConteudoAnsiedade"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_vidro"
                        android:clipToOutline="true">

                        <TextView
                            android:id="@+id/cardConteudoAnsiedade"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:padding="14dp"
                            android:text="5 dicas para reduzir a ansiedade"
                            android:textColor="#4B426D"
                            android:textSize="13sp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"/>

                    </eightbitlab.com.blurview.BlurView>

                    <eightbitlab.com.blurview.BlurView
                        android:id="@+id/blurConteudoBurnout"
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_vidro"
                        android:clipToOutline="true">

                        <TextView
                            android:id="@+id/cardConteudoBurnout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:padding="14dp"
                            android:text="Entendendo o burnout"
                            android:textColor="#4B426D"
                            android:textSize="13sp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"/>

                    </eightbitlab.com.blurview.BlurView>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- Navegação inferior -->

    <LinearLayout
        android:id="@+id/navBeneficiario"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_nav_admin"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navInicioBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#FFFFFF"
            android:textSize="25sp"/>

        <TextView
            android:id="@+id/navAgendamentosBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣"
            android:textColor="#FFFFFF"
            android:textSize="21sp"/>

        <TextView
            android:id="@+id/navMilaBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♧"
            android:textColor="#FFFFFF"
            android:textSize="23sp"/>

        <TextView
            android:id="@+id/navPerfilBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♟"
            android:textColor="#FFFFFF"
            android:textSize="21sp"/>

    </LinearLayout>

</LinearLayout>
