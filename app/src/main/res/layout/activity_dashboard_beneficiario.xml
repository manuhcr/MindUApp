<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo utilizado pelo BlurView -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTargetDashboardBeneficiario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/nova_cole__o_story_do_instagram_bege_marrom_5"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

    </eightbitlab.com.blurview.BlurTarget>

    <!-- Conteúdo dinâmico das telas -->
    <FrameLayout
        android:id="@+id/containerBeneficiario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navBeneficiario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Navegação inferior -->
    <LinearLayout
        android:id="@+id/navBeneficiario"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_nav_admin"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/navInicioBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_inicio"
            android:contentDescription="Início" />

        <ImageView
            android:id="@+id/navAgendamentosBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_agendamentos"
            android:contentDescription="Agendamentos" />

        <ImageView
            android:id="@+id/navImediatoBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_atendimento_imediato"
            android:contentDescription="Atendimento imediato" />

        <ImageView
            android:id="@+id/navPerfilBeneficiario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_user"
            android:contentDescription="Perfil" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
