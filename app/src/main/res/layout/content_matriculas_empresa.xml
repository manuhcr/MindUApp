<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="40dp">

        <!-- CABEÇALHO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Matrículas"
            android:textColor="#75689A"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Gerencie os códigos de acesso dos colaboradores."
            android:textColor="#777184"
            android:textSize="13sp" />

        <!-- RESUMO DAS MATRÍCULAS -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurResumoMatriculas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@android:color/transparent"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- TOTAL -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_vidro"
                    android:backgroundTint="#EEEAF3">

                    <TextView
                        android:id="@+id/txtTotalMatriculas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#292535"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Total"
                        android:textColor="#777184"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- DISPONÍVEIS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_vidro"
                    android:backgroundTint="#E5F3ED">

                    <TextView
                        android:id="@+id/txtMatriculasDisponiveis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#21966A"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Disponíveis"
                        android:textColor="#777184"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- UTILIZADAS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:background="@drawable/bg_vidro"
                    android:backgroundTint="#EEEAF3">

                    <TextView
                        android:id="@+id/txtMatriculasUtilizadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#292535"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Utilizadas"
                        android:textColor="#777184"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- GERAR MATRÍCULAS -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurGerarMatriculas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_vidro"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gerar novas matrículas"
                    android:textColor="#292535"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Informe quantos códigos deseja gerar."
                    android:textColor="#777184"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/edtQuantidadeMatriculas"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Ex.: 5"
                        android:inputType="number"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#292535"
                        android:textColorHint="#9993A5"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnGerarMatriculas"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:backgroundTint="#75689A"
                        android:text="Gerar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- LISTA DE MATRÍCULAS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Suas matrículas"
            android:textColor="#292535"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtListaMatriculasVazia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="Nenhuma matrícula gerada ainda."
            android:textColor="#9993A5"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMatriculasEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

    </LinearLayout>

</ScrollView>
