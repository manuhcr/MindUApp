<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <!-- Cabeçalho -->
        <TextView
            android:id="@+id/txtSaudacaoAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá!"
            android:textColor="#373545"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Painel administrativo"
            android:textColor="#777080"
            android:textSize="14sp" />

        <!-- Boas-vindas -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardBoasVindasAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_vidro"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bem-vindo ao MindU!"
                    android:textColor="#75689A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Gerencie a plataforma e acompanhe as atividades."
                    android:textColor="#777080"
                    android:textSize="13sp" />

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Visão geral -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Visão geral"
            android:textColor="#373545"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Grade de indicadores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- Primeira linha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:orientation="horizontal">

                <!-- Pendentes -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/cardPendentesAdmin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vidro"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:src="@drawable/ic_pendentes_admin"
                            android:contentDescription="Pendentes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pendentes"
                            android:textColor="#777080"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtTotalPendentes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="#75689A"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </eightbitlab.com.blurview.BlurView>

                <!-- Profissionais -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/cardProfissionaisAdmin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vidro"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:src="@drawable/ic_profissionais_admin"
                            android:contentDescription="Profissionais ativos" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profissionais ativos"
                            android:textColor="#777080"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtTotalProfissionais"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="#75689A"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </eightbitlab.com.blurview.BlurView>

            </LinearLayout>

            <!-- Segunda linha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- Empresas -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/cardEmpresasAdmin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vidro"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:src="@drawable/ic_empresas_admin"
                            android:contentDescription="Empresas cadastradas" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Empresas cadastradas"
                            android:textColor="#777080"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtTotalEmpresas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="#75689A"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </eightbitlab.com.blurview.BlurView>

                <!-- Agendamentos -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/cardAgendamentosAdmin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vidro"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginBottom="5dp"
                            android:src="@drawable/ic_agendamentos_admin"
                            android:contentDescription="Agendamentos" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Agendamentos"
                            android:textColor="#777080"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtTotalAgendamentos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="#75689A"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </eightbitlab.com.blurview.BlurView>

            </LinearLayout>

        </LinearLayout>

        <!-- Ações rápidas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ações rápidas"
            android:textColor="#302653"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Gerenciar empresas -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardGerenciarEmpresasAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_atalho_admin"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icone_atalho"
                    android:padding="9dp"
                    android:src="@drawable/ic_atalho_empresas_admin"
                    android:contentDescription="Empresas" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gerenciar empresas"
                        android:textColor="#302653"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Consultar cadastros e planos"
                        android:textColor="#8980A8"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#75689A"
                    android:textSize="27sp" />

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Aprovar profissionais -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardGerenciarProfissionaisAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_atalho_admin"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icone_atalho"
                    android:padding="9dp"
                    android:src="@drawable/ic_atalho_profissionais_admin"
                    android:contentDescription="Profissionais" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aprovar profissionais"
                        android:textColor="#302653"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Revisar solicitações pendentes"
                        android:textColor="#8980A8"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#75689A"
                    android:textSize="27sp" />

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

    </LinearLayout>

</ScrollView>
