<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="22dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvisoHonorariosProfissional"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="#EFFFFFFF"
        app:cardCornerRadius="26dp"
        app:cardElevation="4dp"
        app:strokeColor="#3375689A"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_vidro"
                android:gravity="center"
                android:text="✦"
                android:textColor="#75689A"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/txtTituloAvisoHonorarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Em breve!"
                android:textColor="#292535"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Funcionalidade não disponível"
                android:textColor="#75689A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMensagemAvisoHonorarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Esta funcionalidade não está implementada nesta versão da MindU. Estamos trabalhando para disponibilizá-la futuramente."
                android:textColor="#777184"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
