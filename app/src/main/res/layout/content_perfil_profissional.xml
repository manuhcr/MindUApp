<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@android:color/transparent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Cabeçalho -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil do profissional"
            android:textColor="#4B426D"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Conheça melhor seu profissional"
            android:textColor="#777080"
            android:textSize="13sp" />

        <!-- Informações principais -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurInformacoesProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_vidro">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <ImageView
                    android:id="@+id/imgFotoProfissional"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/bg_vidro"
                    android:contentDescription="Foto do profissional"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/txtNomeProfissional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Nome do profissional"
                    android:textColor="#75689A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTipoProfissional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Especialidade"
                    android:textColor="#777080"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtStatusProfissional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Profissional disponível"
                    android:textColor="#75689A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Especialidades e tags -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurEspecialidadesProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_vidro">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Áreas de atuação"
                    android:textColor="#75689A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTagsProfissional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Especialidades do profissional"
                    android:textColor="#777080"
                    android:textSize="13sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Modalidades -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurModalidadesProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_vidro">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modalidades de atendimento"
                    android:textColor="#75689A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtModalidadesProfissional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Online e presencial"
                    android:textColor="#777080"
                    android:textSize="13sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Informações futuras -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurSobreProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_vidro">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sobre o profissional"
                    android:textColor="#75689A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSobreProfissional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Em breve, você poderá conhecer mais sobre a trajetória e a experiência deste profissional."
                    android:textColor="#777080"
                    android:textSize="13sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Botão de agendamento -->

        <Button
            android:id="@+id/btnAgendarSessaoProfissional"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#75689A"
            android:text="Agendar sessão"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>