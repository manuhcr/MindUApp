<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3F7"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical"
    tools:context=".Acessos">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="900dp">

        <!-- FUNDO + BLUR TARGET -->
        <eightbitlab.com.blurview.BlurTarget
            android:id="@+id/blurTarget"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/nova_cole__o_story_do_instagram_bege_marrom_5" />

        </eightbitlab.com.blurview.BlurTarget>

        <!-- TEXTO -->
        <TextView
            android:id="@+id/texto"
            android:layout_width="310dp"
            android:layout_height="110dp"
            android:layout_marginTop="64dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Para começar, precisamos entender qual o seu perfil de acesso."
            android:textAlignment="viewStart"
            android:textColor="#3D3642"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- BENEFICIÁRIO -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurColaborador"
            android:layout_width="277dp"
            android:layout_height="116dp"
            android:layout_marginTop="32dp"
            android:background="@android:color/transparent"
            app:blurOverlayColor="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/texto">

            <Button
                android:id="@+id/btnColaborador"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/paciente_1"
                android:drawablePadding="24dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="32dp"
                android:paddingEnd="16dp"
                android:text="Sou beneficiário"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="#373545"
                android:textSize="18sp"
                android:textStyle="bold" />
        </eightbitlab.com.blurview.BlurView>

        <!-- EMPRESA -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurEmpresa"
            android:layout_width="277dp"
            android:layout_height="116dp"
            android:layout_marginTop="32dp"
            android:background="@android:color/transparent"
            app:blurOverlayColor="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blurColaborador">

            <Button
                android:id="@+id/btnEmpresa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/companhia_1"
                android:drawablePadding="24dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="32dp"
                android:paddingEnd="16dp"
                android:text="Sou empresa"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="#373545"
                android:textSize="18sp"
                android:textStyle="bold" />
        </eightbitlab.com.blurview.BlurView>

        <!-- PSICÓLOGO -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurPsicologo"
            android:layout_width="277dp"
            android:layout_height="116dp"
            android:layout_marginTop="32dp"
            android:background="@android:color/transparent"
            app:blurOverlayColor="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blurEmpresa">

            <Button
                android:id="@+id/btnPsicologo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/psicologia_1"
                android:drawablePadding="24dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="32dp"
                android:paddingEnd="16dp"
                android:text="Sou psicólogo"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="#373545"
                android:textSize="18sp"
                android:textStyle="bold" />
        </eightbitlab.com.blurview.BlurView>

        <!-- ADMINISTRADOR -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurAdmin"
            android:layout_width="277dp"
            android:layout_height="116dp"
            android:layout_marginTop="32dp"
            android:background="@android:color/transparent"
            app:blurOverlayColor="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/blurPsicologo">

            <Button
                android:id="@+id/btnAdmin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:drawableLeft="@android:drawable/ic_lock_lock"
                android:drawablePadding="34dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="32dp"
                android:paddingEnd="16dp"
                android:text="Sou administrador"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="#373545"
                android:textSize="16sp"
                android:textStyle="bold" />
        </eightbitlab.com.blurview.BlurView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
