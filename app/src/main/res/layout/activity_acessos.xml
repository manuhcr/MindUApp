<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F1F5"
    tools:context=".Acessos">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="678dp"
        android:layout_height="1103dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.722"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/nova_cole__o_story_do_instagram_bege_marrom_6" />

    <TextView
        android:id="@+id/texto"
        android:layout_width="294dp"
        android:layout_height="98dp"
        android:layout_margin="100dp"
        android:layout_marginStart="100dp"
        android:layout_marginTop="120dp"
        android:text="Para começar, precisamos entender qual o seu perfil de acesso. "
        android:textColor="#3d3642"
        android:textSize="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnColaborador"
        android:layout_width="314dp"
        android:layout_height="125dp"
        android:layout_marginTop="80dp"
        android:text="Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/texto" />

    <Button
        android:id="@+id/btnEmpresa"
        android:layout_width="317dp"
        android:layout_height="122dp"
        android:layout_marginTop="52dp"
        android:text="Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnColaborador" />

    <Button
        android:id="@+id/btnPsicologo"
        android:layout_width="309dp"
        android:layout_height="119dp"
        android:layout_marginTop="52dp"
        android:text="Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnEmpresa" />
</androidx.constraintlayout.widget.ConstraintLayout>