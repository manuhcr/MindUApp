<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/transparent">

    <Button
        android:id="@+id/btnVoltarColaboradoresAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹ Início" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Colaboradores"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#75689A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Consulte os colaboradores cadastrados pelas empresas."
        android:textSize="14sp"
        android:textColor="#777777" />

    <EditText
        android:id="@+id/edtBuscarColaborador"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:hint="Buscar colaborador..."
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:inputType="text"
        android:background="@android:drawable/edit_text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvColaboradoresAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txtColaboradoresVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum colaborador encontrado."
        android:textAlignment="center"
        android:textColor="#777777"
        android:visibility="gone" />

</LinearLayout>
