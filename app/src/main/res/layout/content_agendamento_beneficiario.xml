<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:id="@+id/scrollAgendamento"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- CABEÇALHO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendamento"
                android:textColor="#4B426D"
                android:textSize="26sp"
                android:fontFamily="@font/plus_jakarta_sans_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Encontre e marque sua sessão"
                android:textColor="#777184"
                android:textSize="14sp"
                android:fontFamily="@font/plus_jakarta_sans"/>

            <!-- Filtros por tipo, no mesmo estilo de pílulas usado no app -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipTipoTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_filtro_selecionado"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="17dp"
                        android:text="Todos"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans_bold" />

                    <TextView
                        android:id="@+id/chipTipoPsicologo"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_filtro_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="17dp"
                        android:text="Psicólogo"
                        android:textColor="#75689A"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/chipTipoPsiquiatra"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_filtro_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="17dp"
                        android:text="Psiquiatra"
                        android:textColor="#75689A"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/chipTipoTerapeuta"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_filtro_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="17dp"
                        android:text="Terapeuta"
                        android:textColor="#75689A"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- BUSCA -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurBuscaProfissionais"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_vidro"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="#75689A"
                        android:contentDescription="Buscar"/>

                    <EditText
                        android:id="@+id/edtBuscarProfissional"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Buscar especialista ou terapia..."
                        android:textColor="#4B426D"
                        android:textColorHint="#9992A8"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:fontFamily="@font/plus_jakarta_sans"/>

                </LinearLayout>

            </eightbitlab.com.blurview.BlurView>

            <!-- TÍTULO DA LISTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Especialistas disponíveis"
                android:textColor="#4B426D"
                android:textSize="17sp"
                android:fontFamily="@font/plus_jakarta_sans_bold"/>

            <!-- LISTA -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfissionais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:overScrollMode="never"/>

            <TextView
                android:id="@+id/txtNenhumProfissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Nenhum especialista encontrado."
                android:textColor="#777184"
                android:textSize="13sp"
                android:visibility="gone"
                android:fontFamily="@font/plus_jakarta_sans"/>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
