<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FA">

    <ScrollView
        android:id="@+id/scrollAgendamento"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:id="@+id/blurTargetAgendamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Cabeçalho -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendamento"
                android:textColor="#4B426D"
                android:textSize="26sp"
                android:fontFamily="@font/plus_jakarta_sans_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Encontre e marque sua sessão"
                android:textColor="#777184"
                android:textSize="14sp"
                android:fontFamily="@font/plus_jakarta_sans"/>

            <!-- Navegação -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_vidro"
                        android:text="Agendamentos"
                        android:textColor="#75689A"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Meus"
                        android:textColor="#777184"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Gerenciar"
                        android:textColor="#777184"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Imediato"
                        android:textColor="#777184"
                        android:textSize="12sp"
                        android:fontFamily="@font/plus_jakarta_sans"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Busca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_vidro">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:tint="#75689A"
                    android:contentDescription="Buscar"/>

                <EditText
                    android:id="@+id/edtBuscarProfissional"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Buscar especialista ou terapia..."
                    android:textColor="#4B426D"
                    android:textColorHint="#9992A8"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:fontFamily="@font/plus_jakarta_sans"/>

            </LinearLayout>

            <!-- Filtros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Especialistas disponíveis"
                    android:textColor="#4B426D"
                    android:textSize="17sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"/>

                <TextView
                    android:id="@+id/btnFiltrarProfissionais"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Filtrar por  >"
                    android:textColor="#75689A"
                    android:textSize="12sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"/>

            </LinearLayout>

            <!-- Lista de profissionais -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfissionais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:overScrollMode="never"/>

            <TextView
                android:id="@+id/txtNenhumProfissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Nenhum especialista encontrado."
                android:textColor="#777184"
                android:textSize="13sp"
                android:visibility="gone"
                android:fontFamily="@font/plus_jakarta_sans"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
