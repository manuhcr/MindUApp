
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3F7"
    tools:context=".CadastroEmpresa">

    <!-- FUNDO -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTargetCadastro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                app:srcCompat="@drawable/nova_cole__o_story_do_instagram_bege_marrom_6" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Crie sua conta"
                android:textColor="#3D3642"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:text="Cadastre sua empresa para começar!"
                android:textColor="#3D3642"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/textView4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </eightbitlab.com.blurview.BlurTarget>

    <!-- UM ÚNICO CARD DE VIDRO -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurCadastroEmpresa"
        android:layout_width="353dp"
        android:layout_height="553dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="24dp"
        android:background="@android:color/transparent"
        app:blurOverlayColor="#33F5F3F7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:id="@+id/scrollCadastroEmpresa"
            android:layout_width="369dp"
            android:layout_height="541dp"
            android:layout_gravity="center"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:padding="18dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- INDICADOR DAS ETAPAS -->
                <TextView
                    android:id="@+id/textEtapaAtual"
                    android:layout_width="276dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="ETAPA 1 DE 2"
                    android:textColor="#75689A"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="286dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <View
                        android:id="@+id/progressoEtapa1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="#75689A" />

                    <View
                        android:id="@+id/progressoEtapa2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="#55D9D2E5" />

                </LinearLayout>

                <!-- ================================== -->
                <!-- ETAPA 1: DADOS DA EMPRESA           -->
                <!-- ================================== -->

                <!-- ================================== -->
                <!-- ETAPA 2: ENDEREÇO E ACESSO          -->
                <!-- ================================== -->

                <LinearLayout
                    android:id="@+id/layoutEtapa1"
                    android:layout_width="343dp"
                    android:layout_height="470dp"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="273dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Dados da empresa"
                        android:textColor="#3D3642"
                        android:textSize="19sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="281dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Razão social"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRazaoSocial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:inputType="textCapWords"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="281dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome fantasia"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNomeFantasia"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:inputType="textCapWords"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="287dp"
                        android:layout_height="51dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="CNPJ"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCnpj"
                            android:layout_width="280dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:inputType="number"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="281dp"
                        android:layout_height="57dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Inscrição estadual"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtInscricaoEstadual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:inputType="text"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="284dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        android:hint="Nome do responsável"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtResponsavel"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:inputType="textPersonName"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/buttonProximaEtapa"
                        android:layout_width="280dp"
                        android:layout_height="62dp"
                        android:layout_gravity="center"
                        android:backgroundTint="#75689A"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Continuar"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutEtapa2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="287dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Endereço e acesso"
                        android:textColor="#3D3642"
                        android:textSize="19sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="281dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="CEP"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCep"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:inputType="number"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="280dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Logradouro"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtLogradouro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="281dp"
                        android:layout_height="55dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Número"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNumero"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:inputType="text"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="281dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Complemento (opcional)"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtComplemento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="282dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Bairro"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtBairro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="284dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Cidade"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCidade"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:inputType="textCapWords"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="285dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Estado (UF)"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtEstado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLength="2"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="287dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="E-mail corporativo"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtEmailEmpresa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="285dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Telefone"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTelefone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="288dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:hint="Crie sua senha"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtSenha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="288dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        android:hint="ID do plano"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPlanoId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/buttonVoltarEtapa"
                        android:layout_width="205dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#D9D2E5"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Voltar"
                        android:textAllCaps="false"
                        android:textColor="#3D3642"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/button"
                        android:layout_width="205dp"
                        android:layout_height="49dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#75689A"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Criar minha conta"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>