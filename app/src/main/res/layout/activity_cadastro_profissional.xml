<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3F7"
    tools:context=".CadastroProfissional">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTargetCadastro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="432dp"
                android:layout_height="866dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/nova_cole__o_story_do_instagram_bege_marrom_6"
                tools:layout_editor_absoluteX="0dp"
                tools:layout_editor_absoluteY="-8dp" />

            <TextView
                android:id="@+id/textViewTituloCadastro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="92dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Crie sua conta"
                android:textColor="#3D3642"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewSubtituloCadastro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="28dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center"
                android:text="Cadastre-se como profissional no MindU!"
                android:textColor="#3D3642"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewTituloCadastro" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </eightbitlab.com.blurview.BlurTarget>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurCadastroProfissional"
        android:layout_width="353dp"
        android:layout_height="455dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="105dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@android:color/transparent"
        app:blurOverlayColor="#33F5F3F7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:id="@+id/scrollCadastroProfissional"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textEtapaAtual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:text="ETAPA 1 DE 2"
                    android:textColor="#75689A"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <View
                        android:id="@+id/progressoEtapa1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="#75689A" />

                    <View
                        android:id="@+id/progressoEtapa2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="#55D9D2E5" />
                </LinearLayout>

                <!-- ETAPA 1: DADOS DA CONTA -->

                <LinearLayout
                    android:id="@+id/layoutEtapa1"
                    android:layout_width="match_parent"
                    android:layout_height="362dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:text="Dados da conta"
                        android:textColor="#3D3642"
                        android:textSize="19sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome completo"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNomeProfissional"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords|textPersonName"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="E-mail"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtEmailProfissional"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:hint="Crie sua senha (mínimo 8 caracteres)"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtSenha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/buttonProximaEtapa"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#75689A"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Continuar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- ETAPA 2: PERFIL PROFISSIONAL -->

                <LinearLayout
                    android:id="@+id/layoutEtapa2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:gravity="center"
                        android:text="Perfil profissional"
                        android:textColor="#3D3642"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:text="Essas informações são opcionais e podem ser preenchidas depois."
                        android:textColor="#5E5665"
                        android:textSize="12sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Tipo de profissional (opcional)"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTipoProfissional"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:minHeight="52dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Especialidades, separadas por vírgula (opcional)"
                        app:boxBackgroundColor="#55F5F3F7"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintTextColor="#75689A">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minHeight="72dp"
                            android:textColor="#3E3545"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Carteirinha profissional (opcional)"
                        android:textColor="#3D3642"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnSelecionarCarteirinha"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="#D9D2E5"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Selecionar imagem"
                        android:textAllCaps="false"
                        android:textColor="#3D3642"
                        app:cornerRadius="12dp" />

                    <TextView
                        android:id="@+id/textCarteirinhaSelecionada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:text="Nenhuma imagem selecionada"
                        android:textColor="#5E5665"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/buttonVoltarEtapa"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#D9D2E5"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Voltar"
                        android:textAllCaps="false"
                        android:textColor="#3D3642"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnCriarConta"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="12dp"
                        android:backgroundTint="#75689A"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Criar minha conta"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>