<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_vidro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtCodigoMatricula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A1B2C3"
            android:textColor="#292535"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatusMatricula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:text="Disponível"
            android:textColor="#21966A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#E5F3ED" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtBeneficiarioMatricula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Colaborador: Maria Silva"
        android:textColor="#777184"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnCopiarMatricula"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:backgroundTint="@android:color/transparent"
        android:text="Copiar código"
        android:textAllCaps="false"
        android:textColor="#75689A"
        android:textSize="11sp" />

</LinearLayout>
