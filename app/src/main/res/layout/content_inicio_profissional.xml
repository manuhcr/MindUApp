<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MindU Profissional"
            android:textColor="#75689A"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />

        <TextView
            android:id="@+id/txtSaudacaoProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Olá!"
            android:textColor="#292535"
            android:textSize="25sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Organize seus atendimentos e seu espaço de cuidado."
            android:textColor="#777184"
            android:textSize="13sp"
            android:fontFamily="@font/plus_jakarta_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Resumo do dia"
            android:textColor="#292535"
            android:textSize="19sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />

        <eightbitlab.com.blurview.BlurView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_vidro">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atendimentos agendados para hoje"
                    android:textColor="#777184"
                    android:textSize="12sp"
                    android:fontFamily="@font/plus_jakarta_sans" />
                <TextView
                    android:id="@+id/txtResumoDiaProfissional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Carregando agenda…"
                    android:textColor="#4B426D"
                    android:textSize="18sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold" />
                <TextView
                    android:id="@+id/txtProximoAtendimentoProfissional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Buscando próximo atendimento…"
                    android:textColor="#777184"
                    android:textSize="13sp"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Acesso rápido"
            android:textColor="#292535"
            android:textSize="19sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardAgendaProfissionalHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_vidro">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_agendamentos"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Minha agenda" android:textColor="#4B426D" android:textSize="15sp"
                        android:fontFamily="@font/plus_jakarta_sans_bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:text="Ver horários e iniciar atendimentos"
                        android:textColor="#777184" android:textSize="12sp" android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_rignt" android:contentDescription="Abrir agenda" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardDisponibilidadeProfissionalHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_vidro">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_calendar" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Disponibilidade" android:textColor="#4B426D" android:textSize="15sp"
                        android:fontFamily="@font/plus_jakarta_sans_bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:text="Defina os horários de atendimento"
                        android:textColor="#777184" android:textSize="12sp" android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_rignt" android:contentDescription="Abrir disponibilidade" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardPerfilProfissionalHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_vidro">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_user" android:contentDescription="@null" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Meu perfil" android:textColor="#4B426D" android:textSize="15sp"
                        android:fontFamily="@font/plus_jakarta_sans_bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:text="Atualize sua foto e apresentação"
                        android:textColor="#777184" android:textSize="12sp" android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_rignt" android:contentDescription="Abrir perfil" />
            </LinearLayout>
        </eightbitlab.com.blurview.BlurView>

    </LinearLayout>
</LinearLayout>
