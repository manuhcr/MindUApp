<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Profissionais"
        android:textColor="#75689A"
        android:textSize="22sp"
        android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Gerencie os cadastros e solicitações de profissionais."
            android:textSize="14sp"
            android:textColor="#777777"/>
        <TextView
            android:id="@+id/txtListaVazia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Não há profissionais pendentes de aprovação."
            android:textSize="14sp"
            android:textColor="#777777"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="24dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProfissionais"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"/>



</LinearLayout>