<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_vidro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNomeProfissional"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dra. Amanda Rossi"
                android:textColor="#75689A"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Dr. Lucas Prado" />

            <TextView
                android:id="@+id/txtAvaliacaoProfissional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 4.9"
                android:textColor="#75689A"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtEspecialidadeProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Psicoterapeuta Cognitivo"
            android:textColor="#777080"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtQuantidadeConsultas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="128 consultas"
            android:textColor="#777080"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#5575689A" />

        <TextView
            android:id="@+id/txtDisponibilidadeProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Hoje, às 15:30"
            android:textColor="#5E586B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnVerPerfilProfissional"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_status_aprovado"
            android:gravity="center"
            android:text="Ver perfil completo"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</eightbitlab.com.blurview.BlurView>
