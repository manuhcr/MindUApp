<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_vidro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PROFISSIONAL"
                android:textColor="#75689A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/txtStatusProfissional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_aprovado"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="APROVADO"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="PENDENTE"
                tools:background="@drawable/bg_status_pendente" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtNomeProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Nome do profissional"
            android:textColor="#75689A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#5575689A" />

        <TextView
            android:id="@+id/txtIdProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID: 123"
            android:textColor="#777080"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutAcoesProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            tools:visibility="visible">

            <Button
                android:id="@+id/btnAprovar"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#75689A"
                android:text="Aprovar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRejeitar"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:backgroundTint="#EAE6F0"
                android:text="Rejeitar"
                android:textAllCaps="false"
                android:textColor="#75689A"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</eightbitlab.com.blurview.BlurView>
