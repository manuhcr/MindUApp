<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginAdmin">


    <!-- ========================================================= -->
    <!-- CONTEÚDO QUE SERÁ USADO COMO FUNDO DO BLUR               -->
    <!-- ========================================================= -->

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTargetAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ================================================= -->
            <!-- FUNDO                                             -->
            <!-- ================================================= -->


            <!-- ================================================= -->
            <!-- TÍTULO                                            -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imgFundoAdmin"
                android:layout_width="678dp"
                android:layout_height="1103dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.801"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.997"
                app:srcCompat="@drawable/nova_cole__o_story_do_instagram_bege_marrom_6" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="330dp"
                android:layout_height="39dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="80dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Bem-vindo à MindU!"
                android:textColor="#3D3642"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- ================================================= -->
            <!-- SUBTÍTULO                                         -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/textView3"
                android:layout_width="262dp"
                android:layout_height="86dp"
                android:layout_marginEnd="32dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Acesse sua conta de administrador!"
                android:textColor="#3D3642"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView4" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </eightbitlab.com.blurview.BlurTarget>


    <!-- ========================================================= -->
    <!-- CARD DE VIDRO                                            -->
    <!-- ========================================================= -->

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurCadastroAdmin"
        android:layout_width="294dp"
        android:layout_height="379dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="50dp"
        android:background="@android:color/transparent"
        app:blurOverlayColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutLoginAdmin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ================================================= -->
            <!-- CAMPO EMAIL                                       -->
            <!-- ================================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputEmailAdmin"
                android:layout_width="230dp"
                android:layout_height="50dp"
                android:layout_marginTop="80dp"
                android:hint=""
                android:textColorHint="#3E3545"
                app:boxBackgroundColor="#55F5F3F7"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:hintTextColor="#3E3545"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmailAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66FFFFFF"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:textColor="#3E3545"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================= -->
            <!-- CAMPO SENHA                                       -->
            <!-- ================================================= -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputSenhaAdmin"
                android:layout_width="230dp"
                android:layout_height="50dp"
                android:layout_marginTop="40dp"
                android:hint=""
                android:textColorHint="#3E3545"
                app:boxBackgroundColor="#55F5F3F7"
                app:boxBackgroundMode="filled"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:endIconMode="password_toggle"
                app:hintTextColor="#3E3545"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inputEmailAdmin">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtSenhaAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66FFFFFF"
                    android:hint="Senha"
                    android:inputType="textPassword"
                    android:textColor="#3E3545"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================= -->
            <!-- BOTÃO ENTRAR                                      -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnEntrarAdmin"
                android:layout_width="118dp"
                android:layout_height="48dp"
                android:layout_marginTop="52dp"
                android:backgroundTint="#75689A"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.497"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/inputSenhaAdmin" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </eightbitlab.com.blurview.BlurView>


    <!-- ========================================================= -->
    <!-- TEXTOS ABAIXO DO CARD                                    -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/textAcessoAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:fontFamily="@font/plus_jakarta_sans_light"
        android:text="Área exclusiva para"
        android:textColor="#3E3545"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/blurCadastroAdmin" />


    <TextView
        android:id="@+id/textAdminMindU"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="administradores da MindU"
        android:textColor="#3E3545"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textAcessoAdmin" />

</androidx.constraintlayout.widget.ConstraintLayout>
