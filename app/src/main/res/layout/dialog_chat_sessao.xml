<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blurChatSessao"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vidro"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- CABEÇALHO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat da sessão"
                    android:textColor="@color/mindu_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNomeEspecialistaChat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Dra. Amanda Rossi"
                    android:textColor="@color/mindu_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFecharChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Fechar chat"
                android:src="@drawable/ic_close"
                android:tint="@color/mindu_text_primary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mindu_glass_divider" />

        <!-- MENSAGENS -->

        <ScrollView
            android:id="@+id/scrollMensagens"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingVertical="16dp">

            <LinearLayout
                android:id="@+id/containerMensagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- AVISO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_vidro"
                    android:padding="10dp"
                    android:text="As mensagens são privadas durante a sessão."
                    android:textColor="@color/mindu_text_secondary"
                    android:textSize="11sp" />

                <!-- MENSAGEM DO ESPECIALISTA -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_vidro"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dra. Amanda"
                        android:textColor="@color/mindu_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Olá! Como você está se sentindo hoje?"
                        android:textColor="@color/mindu_text_body"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp"
                        android:text="15:32"
                        android:textColor="@color/mindu_text_hint"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- MENSAGEM DO BENEFICIÁRIO -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_vidro"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estou bem, obrigada!"
                        android:textColor="@color/mindu_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp"
                        android:text="15:33"
                        android:textColor="@color/mindu_text_hint"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- CAMPO DE ENVIO -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mindu_glass_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtMensagemChat"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_vidro"
                android:hint="Digite sua mensagem..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingHorizontal="14dp"
                android:textColor="@color/mindu_text_primary"
                android:textColorHint="@color/mindu_text_hint"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnEnviarMensagem"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_vidro"
                android:contentDescription="Enviar mensagem"
                android:padding="12dp"
                android:src="@drawable/ic_send"
                android:tint="@color/mindu_primary" />

        </LinearLayout>

    </LinearLayout>

</eightbitlab.com.blurview.BlurView>
