<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent"
    android:scrollbars="none">

    <eightbitlab.com.blurview.BlurView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_vidro">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Cabeçalho -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar agendamento"
                android:textColor="#75689A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Confira os detalhes antes de finalizar."
                android:textColor="#777080"
                android:textSize="13sp" />

            <!-- Ícone -->

            <!-- Profissional -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="PROFISSIONAL"
                android:textColor="#75689A"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtConfirmacaoProfissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Dra. Amanda Rossi"
                android:textColor="#4B426D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#5575689A" />

            <!-- Data -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATA"
                android:textColor="#75689A"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtConfirmacaoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="18 de novembro de 2026"
                android:textColor="#5E586B"
                android:textSize="14sp" />

            <!-- Horário -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="HORÁRIO"
                android:textColor="#75689A"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtConfirmacaoHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="10:00"
                android:textColor="#5E586B"
                android:textSize="14sp" />

            <!-- Modalidade -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="MODALIDADE"
                android:textColor="#75689A"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtConfirmacaoModalidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Online"
                android:textColor="#5E586B"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:background="#5575689A" />

            <!-- Aviso -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_vidro"
                android:padding="14dp"
                android:text="Ao confirmar, sua solicitação de agendamento será registrada. Aguarde a confirmação da disponibilidade."
                android:textColor="#777080"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />

            <!-- Ações -->
            <Button
                android:id="@+id/btnConfirmarAgendamento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#75689A"
                android:text="Confirmar agendamento"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnVoltarAgendamento"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Voltar e editar"
                android:textColor="#75689A"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </eightbitlab.com.blurview.BlurView>

</ScrollView>
