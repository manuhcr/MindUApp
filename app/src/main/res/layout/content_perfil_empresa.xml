<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABEÇALHO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Meu perfil"
            android:textColor="@color/mindu_primary"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Informações da sua conta empresarial."
            android:textColor="@color/mindu_text_secondary"
            android:textSize="14sp"/>

        <!-- IDENTIFICAÇÃO DA EMPRESA -->

        <LinearLayout
            android:id="@+id/cardIdentificacaoEmpresaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_avatar_admin">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="17dp"
                    android:src="@drawable/ic_users"
                    android:scaleType="centerInside"
                    android:contentDescription="Empresa"/>

            </FrameLayout>

            <TextView
                android:id="@+id/txtNomeEmpresaPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nome da empresa"
                android:textColor="@color/mindu_text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/txtPlanoEmpresaPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Plano contratado"
                android:textColor="@color/mindu_text_secondary"
                android:textSize="14sp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- INFORMAÇÕES DA CONTA -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardDadosContaEmpresaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:textAlignment="center">

                <TextView
                    android:id="@+id/txtEmailEmpresaPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="EMAIL DA EMPRESA"
                    android:textAlignment="center"
                    android:textColor="@color/mindu_secondary"
                    android:textSize="16sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/mindu_glass_divider"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="INFORMAÇÕES DA EMPRESA"
                    android:textColor="@color/mindu_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Razão social"
                    android:textColor="@color/mindu_text_secondary"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtRazaoSocialPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Razão social da empresa"
                    android:textColor="@color/mindu_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Plano contratado"
                    android:textColor="@color/mindu_text_secondary"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtPlanoDetalhesPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Plano da empresa"
                    android:textColor="@color/mindu_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Status da conta"
                    android:textColor="@color/mindu_text_secondary"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtStatusContaEmpresaPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Ativa"
                    android:textColor="@color/mindu_success"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- DADOS DA CONTA -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardMinhaContaEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dados da empresa"
                        android:textColor="@color/mindu_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Informações cadastrais da empresa"
                        android:textColor="@color/mindu_text_secondary"
                        android:textSize="12sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/mindu_primary"
                    android:textSize="28sp"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- PLANO -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardPlanoEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meu plano"
                        android:textColor="@color/mindu_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Consulte seu plano e benefícios"
                        android:textColor="@color/mindu_text_secondary"
                        android:textSize="12sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/mindu_primary"
                    android:textSize="28sp"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- SUPORTE -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardSuporteEmpresaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suporte"
                        android:textColor="@color/mindu_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Entre em contato com a equipe MindU"
                        android:textColor="@color/mindu_text_secondary"
                        android:textSize="12sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/mindu_primary"
                    android:textSize="28sp"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- SAIR DA CONTA -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardSairEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sair da conta"
                    android:textColor="@color/mindu_error"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/mindu_error"
                    android:textSize="28sp"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

    </LinearLayout>

</ScrollView>
