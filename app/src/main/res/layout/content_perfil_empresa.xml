<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="90dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Cabeçalho -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meu perfil"
            android:textColor="#75689A"
            android:textSize="25sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Gerencie as informações da sua conta"
            android:textColor="#777184"
            android:textSize="13sp"/>

        <!-- Identificação -->

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardIdentificacaoEmpresaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_vidro"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/ic_users"
                    android:padding="17dp"
                    android:background="@drawable/bg_nav_admin"
                    android:contentDescription="Ícone da conta"/>

                <TextView
                    android:id="@+id/txtNomeEmpresaPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nome da conta"
                    android:textColor="#75689A"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:fontFamily="@font/plus_jakarta_sans_bold"/>

                <TextView
                    android:id="@+id/txtPlanoEmpresaPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Tipo de conta"
                    android:textColor="#777184"
                    android:textSize="13sp"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Dados da conta -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:text="Dados da conta"
            android:textColor="#75689A"
            android:textSize="17sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"/>

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardDadosContaEmpresaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_vidro"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-mail"
                    android:textColor="#777184"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtRazaoSocialPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="—"
                    android:textColor="#75689A"
                    android:textSize="15sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E8E3F0"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status da conta"
                    android:textColor="#777184"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtPlanoDetalhesPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="—"
                    android:textColor="#75689A"
                    android:textSize="15sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

        <!-- Suporte -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:text="Ajuda e suporte"
            android:textColor="#75689A"
            android:textSize="17sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"/>

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/cardSuporteEmpresaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_vidro"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Precisa de ajuda com a MindU?"
                    android:textColor="#75689A"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Entre em contato com nossa equipe para receber suporte."
                    android:textColor="#777184"
                    android:textSize="12sp"/>

            </LinearLayout>

        </eightbitlab.com.blurview.BlurView>

    </LinearLayout>

</ScrollView>
