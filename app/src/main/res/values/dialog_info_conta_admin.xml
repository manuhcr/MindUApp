<?xml version="1.0" encoding="utf-8"?>
<resources>
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_avatar_admin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Informações da conta"
            android:textColor="#75689A"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Nome completo"
            android:textColor="#8A80A8"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/dialogNomeAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#302653"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="E-mail"
            android:textColor="#8A80A8"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/dialogEmailAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#302653"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tipo de acesso"
            android:textColor="#8A80A8"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Administrador"
            android:textColor="#302653"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnEditarContaAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:text="Editar informações"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#75689A"/>

    </LinearLayout>
</resources>